            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">int length = 1000

int min = -100
int max = 100

def list = (1..length).collect { 
    new Random().nextInt(max - min + 1) + min 
}

def json = [data: list, criteria: &quot;ALL&quot;]

vars.put(&quot;randomJson&quot;, new groovy.json.JsonBuilder(json).toString())
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
